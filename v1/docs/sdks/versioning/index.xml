			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="https://criblio.github.io/cribl-python-sdk/v1/docs/errors/servererror/"&gt;&lt;code&gt;ServerError&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
