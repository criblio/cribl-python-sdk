&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;Method&lt;/th&gt;
					&lt;th&gt;Description&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="#create"&gt;&lt;code&gt;create&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;Create a Database Connection.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="#delete"&gt;&lt;code&gt;delete&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;Delete a Database Connection.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="#get"&gt;&lt;code&gt;get&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;Get a Database Connection.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="#list"&gt;&lt;code&gt;list&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;List all Database Connections.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="#update"&gt;&lt;code&gt;update&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;Update a Database Connection.&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;h2 id="operations"&gt;Operations&lt;a class="anchor" href="#operations"&gt;#&lt;/a&gt;&lt;/h2&gt;
&lt;h3 id="create"&gt;create&lt;a class="anchor" href="#create"&gt;#&lt;/a&gt;&lt;/h3&gt;
&lt;pre tabindex="0"&gt;&lt;code&gt;client.databaseconnections.create(...)&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;Create a Database Connection.&lt;/p&gt;
&lt;p&gt;Create a new Database Connection.&lt;/p&gt;
&lt;h4 id="example-usage"&gt;Example Usage&lt;a class="anchor" href="#example-usage"&gt;#&lt;/a&gt;&lt;/h4&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-python" data-lang="python"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#75715e"&gt;# Example request body for creating a MySQL Database Connection using a connection string with embedded credentials.&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;client&lt;span style="color:#f92672"&gt;.&lt;/span&gt;databaseconnections&lt;span style="color:#f92672"&gt;.&lt;/span&gt;create(
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; id&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;mysql-prod-db&amp;#34;&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; description&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;Production MySQL database for customer data&amp;#34;&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; databaseType&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;mysql&amp;#34;&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; authType&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;connectionString&amp;#34;&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; connectionString&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;mysql://yourUsername:yourPassword@mysql.example.com:3306/production?ssl=true&amp;#34;&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; connectionTimeout&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#ae81ff"&gt;10000&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; tags&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;production,mysql,customer-data&amp;#34;&lt;/span&gt;,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h4 id="parameters"&gt;Parameters&lt;a class="anchor" href="#parameters"&gt;#&lt;/a&gt;&lt;/h4&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;Parameter&lt;/th&gt;
					&lt;th&gt;Type&lt;/th&gt;
					&lt;th&gt;Required&lt;/th&gt;
					&lt;th&gt;Default&lt;/th&gt;
					&lt;th&gt;Description&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;id&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;str&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Yes&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Unique identifier for the Database Connection&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;databaseType&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;Literal[&amp;quot;mysql&amp;quot;, &amp;quot;oracle&amp;quot;, &amp;quot;postgres&amp;quot;, &amp;quot;sqlserver&amp;quot;, &amp;quot;teradata&amp;quot;]&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Yes&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Type of database engine for the connection. Valid values: &amp;ldquo;mysql&amp;rdquo;, &amp;ldquo;oracle&amp;rdquo;, &amp;ldquo;postgres&amp;rdquo;, &amp;ldquo;sqlserver&amp;rdquo;, &amp;ldquo;teradata&amp;rdquo;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;authType&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;Literal[&amp;quot;configObj&amp;quot;, &amp;quot;connectionString&amp;quot;, &amp;quot;secret&amp;quot;, &amp;quot;secrets&amp;quot;]&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Yes&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Authentication method for the Database Connection. Determines how credentials are provided. Valid values: &amp;ldquo;configObj&amp;rdquo;, &amp;ldquo;connectionString&amp;rdquo;, &amp;ldquo;secret&amp;rdquo;, &amp;ldquo;secrets&amp;rdquo;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;description&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;str&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Yes&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Brief description of the Database Connection&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;configObj&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;str | None&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;No&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;JSON configuration object for advanced SQL Server connection settings&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;connectionString&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;str | None&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;No&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Database connection string with embedded credentials or server information&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;connectionTimeout&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;int | None&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;No&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Maximum time (in milliseconds) to wait when establishing the database connection&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;credentialsSecret&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;str | None&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;No&lt;/td&gt;
					&lt;td&gt;—&lt;/td&gt;
					&lt;td&gt;Name of the stored credentials secret containing username and password for SQL Server configObj authentication&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;credsSecrets&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;str | None&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;No&lt;/td&gt;
