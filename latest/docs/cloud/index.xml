					&lt;td&gt;Yes&lt;/td&gt;
					&lt;td&gt;Role assignments for the API Credential&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;ipAllowlist&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;list[str] | None&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;No&lt;/td&gt;
